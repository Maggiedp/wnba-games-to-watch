# This file specifies files that should NOT be uploaded to Cloud Run
__pycache__
*.pyc
.pytest_cache
.git
.gitignore
.env
.env.local
venv
ENV
env
node_modules
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
logs
data/games_to_watch.db
# offline darko/spike data caches (gitignored; never needed in the prod image)
src/darko/_stats_cache
src/darko/_cache
scripts/spikes/cache

# Local-only, never needed in the prod image. NOTE: when a .gcloudignore
# exists, gcloud does NOT fall back to .gitignore — so gitignored dirs must be
# listed here explicitly or `--source .` uploads them into the build context.
# docs/ in particular holds local OAuth credentials for the award-ranking
# scripts; nothing in the app reads any of these.
docs
.superpowers
.claude
tests
